FROM node:20-bookworm-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      python3 \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv

COPY services/conversation/package.json services/conversation/package-lock.json ./services/conversation/
RUN cd services/conversation && npm ci --omit=dev

COPY services/ate/requirements.txt /tmp/requirements-ate.txt
COPY services/crisis/requirements.txt /tmp/requirements-crisis.txt
COPY services/emotion/requirements.txt /tmp/requirements-emotion.txt
COPY services/filter/requirements.txt /tmp/requirements-filter.txt
RUN cat /tmp/requirements-*.txt > /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY services ./services
COPY data/postgres/migrations ./services/conversation/migrations
COPY infra/start-backend.sh ./infra/start-backend.sh
RUN chmod +x ./infra/start-backend.sh

EXPOSE 3000

CMD ["./infra/start-backend.sh"]
